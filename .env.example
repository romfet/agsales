# Скопируйте в .env и заполните ПЕРЕД выставлением сервиса наружу.
#   cp .env.example .env
# .env — в .gitignore, секретов в compose нет (только ${...}).
# Пустой AUTH_JWT_SECRET = авторизация ВЫКЛЮЧЕНА (только локальная разработка!).
# Для публичного стенда секрет обязателен.

# --- PostgreSQL (compose собирает из них DATABASE_URL) ---
# POSTGRES_PASSWORD обязателен (в compose дефолта нет). На стенде значение НЕ меняем
# без пересоздания тома (postgres задаёт пароль только при первой инициализации).
POSTGRES_USER=agsales
POSTGRES_PASSWORD=agsales
POSTGRES_DB=agsales

# Длинный случайный секрет для подписи токенов (HS256). Сгенерировать:
#   openssl rand -hex 32
AUTH_JWT_SECRET=

# Клиенты, которым выдаём доступ (JSON одной строкой). client_secret передать
# по защищённому каналу. scopes: ingest — приём истории, analyze — анализ заявки,
# effect — выгрузка витрины эффекта в BI. Пример с 1С- и BI-клиентом:
AUTH_CLIENTS=[{"client_id":"onec","client_secret":"CHANGE_ME","scopes":["ingest","analyze"]},{"client_id":"bi","client_secret":"CHANGE_ME","scopes":["effect"]}]

# --- Необязательные тюнинги (можно не задавать — берутся значения по умолчанию) ---
# TTL выдаваемого JWT, секунд (деф. 3600).
#AUTH_TOKEN_TTL_SECONDS=3600
# Период пересборки витрин воркером, минут (деф. 10).
#REFRESH_INTERVAL_MINUTES=10
