# Скопируйте в .env и заполните ПЕРЕД выставлением сервиса наружу.
#   cp .env.example .env
# .env — в .gitignore, секретов в compose нет (только ${...}).
# Пустой AUTH_JWT_SECRET = авторизация ВЫКЛЮЧЕНА (только локальная разработка!).
# Для публичного стенда секрет обязателен.

# --- PostgreSQL (compose собирает из них DATABASE_URL) ---
# POSTGRES_PASSWORD обязателен (в compose дефолта нет). На стенде значение НЕ меняем
# без пересоздания тома (postgres задаёт пароль только при первой инициализации).
POSTGRES_USER=agsales
POSTGRES_PASSWORD=agsales
POSTGRES_DB=agsales

# Длинный случайный секрет для подписи токенов (HS256). Сгенерировать:
#   openssl rand -hex 32
AUTH_JWT_SECRET=

# Клиенты, которым выдаём доступ (JSON одной строкой). client_secret передать
# по защищённому каналу. scopes: ingest — приём истории, analyze — анализ заявки,
# effect — выгрузка витрины эффекта в BI. Пример с 1С- и BI-клиентом:
AUTH_CLIENTS=[{"client_id":"onec","client_secret":"CHANGE_ME","scopes":["ingest","analyze"]},{"client_id":"bi","client_secret":"CHANGE_ME","scopes":["effect"]}]

# --- Необязательные тюнинги (можно не задавать — берутся значения по умолчанию) ---
# TTL выдаваемого JWT, секунд (деф. 3600).
#AUTH_TOKEN_TTL_SECONDS=3600
# Период пересборки витрин воркером, минут (деф. 10).
#REFRESH_INTERVAL_MINUTES=10

# --- Приём данных 1С (docs/SDD_сборка_документов_при_приёме.md) ---
# direct — каждый запрос заменяет документ целиком (прежнее поведение);
# staged — пачки копятся и собираются worker'ом по документам (1С шлёт документ частями).
# После смены значения — `docker compose ... up -d` (пересоздание, не restart).
#INGEST_MODE=direct
# /commit в режиме direct: deferred — ответ сразу, агрегаты пересобирает worker раз в
# REFRESH_INTERVAL_MINUTES (1С зовёт commit после каждой пачки); sync — как раньше.
#INGEST_COMMIT_REFRESH=deferred
# keep — позиции, которых нет в загрузке, не удаляются (по умолчанию); replace — удаляются;
# replace_on_commit — удаляются только в сборке по commit.
#INGEST_SHRINK_MODE=keep
# Собирать по commit (сейчас 1С вызывает commit после каждой пачки — не включать).
#INGEST_MERGE_ON_COMMIT=false
# Сборка после паузы в пачках, минут; страховка по возрасту старейшей пачки, минут.
#INGEST_MERGE_IDLE_MINUTES=60
#INGEST_MERGE_MAX_DELAY_MINUTES=1440
# Окно слияния версий заказа, разрезанного границей автосборки, минут.
#INGEST_VERSION_COALESCE_MINUTES=240
# Сколько дней хранить собранные пачки (для разбора).
#INGEST_BATCH_RETENTION_DAYS=7
