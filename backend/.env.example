# Copy to backend/.env and adjust (host-run dev; секрет не коммитить).
DATABASE_URL=postgresql+psycopg://agsales:CHANGE_ME@localhost:5432/agsales

# --- 1C HTTP-service (phase 2) ---
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=

# --- Приём данных 1С (docs/SDD_сборка_документов_при_приёме.md) ---
# direct — каждый запрос заменяет документ целиком (прежнее поведение);
# staged — пачки копятся и собираются worker'ом по документам (1С шлёт документ частями).
# После смены значения — `docker compose ... up -d` (пересоздание, не restart).
#INGEST_MODE=direct
# keep — позиции, которых нет в загрузке, не удаляются (по умолчанию); replace — удаляются;
# replace_on_commit — удаляются только в сборке по commit.
#INGEST_SHRINK_MODE=keep
# Собирать по commit (сейчас 1С вызывает commit после каждой пачки — не включать).
#INGEST_MERGE_ON_COMMIT=false
# Сборка после паузы в пачках, минут; страховка по возрасту старейшей пачки, минут.
#INGEST_MERGE_IDLE_MINUTES=60
#INGEST_MERGE_MAX_DELAY_MINUTES=1440
# Окно слияния версий заказа, разрезанного границей автосборки, минут.
#INGEST_VERSION_COALESCE_MINUTES=240
# Сколько дней хранить собранные пачки (для разбора).
#INGEST_BATCH_RETENTION_DAYS=7
